{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "types": ["chrome", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "e2e/**/*",
    "*.config.ts",
    ".wxt/**/*"
  ],
  "exclude": ["node_modules", ".output", "dist"]
}
